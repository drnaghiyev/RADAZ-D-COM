+/** Build each acquired tablet slice at its native matrix up to 512, in patient order. */
+export async function tabletSourceVolume(imageIds:string[], maxTexture:number, signal:AbortSignal, progress:(percent:number)=>void) {
+  signal.throwIfAborted();
+  const source=seriesGeometry(imageIds);
+  const [columns,rows,depth]=source.dimensions;
+  const scale=Math.min(1,512/Math.max(columns,rows));
+  const width=Math.max(1,Math.round(columns*scale)), height=Math.max(1,Math.round(rows*scale));
+  const dimensions:Point3=[width,height,depth];
+  const geometry=displayGeometry(source,dimensions);
+  const sample=scale<1 ? displayPlaneSampler(columns,rows,areaWeights(columns,width),areaWeights(rows,height),false) : null;
+  const planeSize=width*height, length=planeSize*depth;
+  let values:Int16Array|Float32Array=sample ? new Float32Array(length) : new Int16Array(length);
+  let minimum=Infinity, maximum=-Infinity, lastYield=performance.now();
+  for(let z=0;z<depth;z++){
+    signal.throwIfAborted();
+    const record=await readDisplayPlane(source.imageIds[z],signal);
+    signal.throwIfAborted();
+    if(record.color || record.columns!==columns || record.rows!==rows || record.pixels.length!==columns*rows)
+      throw Error('3D üçün eyni ölçülü monoxrom KT və ya MRT kəsikləri seçin.');
+    const plane=sample ? sample(record.pixels) : record.pixels;
+    if(values instanceof Int16Array && plane instanceof Float32Array &&
+       (record.min < -32768 || record.max > 32767 || !plane.every(Number.isInteger))){
+      const full=new Float32Array(length);
+      full.set(values.subarray(0,z*planeSize));
+      values=full;
+    }
+    values.set(plane,z*planeSize);
+    if(sample){
+      for(let i=0;i<planeSize;i++){minimum=Math.min(minimum,plane[i]);maximum=Math.max(maximum,plane[i]);}
+    }else{
+      minimum=Math.min(minimum,record.min);maximum=Math.max(maximum,record.max);
+    }
+    if(performance.now()-lastYield>16){
+      progress(Math.round(100*(z+1)/depth));
+      await yieldToBrowser();lastYield=performance.now();
+    }
+  }
+  signal.throwIfAborted();
+  progress(100);
+  const range:[number,number]=[minimum,Math.max(minimum+1,maximum)];
+  return {...geometry,values,range,cpuOnly:dimensions.some(n=>n>maxTexture)};
 }
 
